{
  "format": "openillusion.template",
  "version": 2,
  "id": "local/qwen21-outfit-swap",
  "mode": "edit",
  "label": "Outfit swap",
  "model_name": "Qwen Image 2.1",
  "provider": "qwen",
  "blurb": "Dresses the person in Image 1 in the garment from Image 2. Fabric, color and pattern carry over; the person stays the same.",
  "source": "ComfyUI template image_qwen_image_2_1_image_edit (prompt enhancer left out)",
  "inputs": [
    {
      "key": "image:1",
      "type": "image",
      "required": true,
      "default": "media/man-greytee.jpg",
      "bind": [
        [
          "11",
          "image"
        ]
      ]
    },
    {
      "key": "image:2",
      "type": "image",
      "required": true,
      "default": "media/bomber-flatlay.jpg",
      "bind": [
        [
          "12",
          "image"
        ]
      ]
    },
    {
      "key": "prompt",
      "type": "text",
      "required": true,
      "default": "Dress the person in <image1> in the outfit shown in <image2>. Keep it unbuttoned. Match the garment's color, fabric, pattern, details and fit exactly, draped naturally on their body and pose. Keep the face, identity, hair, pose, body shape, lighting, framing and background of <image1> exactly as they are.",
      "bind": [
        [
          "5",
          "prompt"
        ]
      ]
    }
  ],
  "size": {
    "multiple": 32
  },
  "outputs": [
    "9"
  ],
  "hints": {
    "models": {
      "qwen_image_2.1_int8_convrot.safetensors": {
        "folder": "diffusion_models",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/diffusion_models/qwen_image_2.1_int8_convrot.safetensors"
      },
      "qwen3vl_8b_int8_convrot.safetensors": {
        "folder": "text_encoders",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/text_encoders/qwen3vl_8b_int8_convrot.safetensors"
      },
      "qwen_image_2.1_vae_bf16.safetensors": {
        "folder": "vae",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/vae/qwen_image_2.1_vae_bf16.safetensors"
      }
    },
    "nodes": {}
  },
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "QwenImage21Cache",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "device": "cpu",
        "dtype": "default"
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
        "type": "qwen_image",
        "device": "default"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
      }
    },
    "11": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{image:1}}"
      },
      "_meta": {
        "title": "Image 1"
      }
    },
    "5": {
      "class_type": "TextEncodeQwenImage21",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "prompt": "Dress the person in <image1> in the outfit shown in <image2>. Keep it unbuttoned. Match the garment's color, fabric, pattern, details and fit exactly, draped naturally on their body and pose. Keep the face, identity, hair, pose, body shape, lighting, framing and background of <image1> exactly as they are.",
        "negative_prompt": "",
        "resolution": 0,
        "images.image_1": [
          "11",
          0
        ],
        "images.image_2": [
          "12",
          0
        ]
      },
      "_meta": {
        "title": "Edit"
      }
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "negative": [
          "5",
          1
        ],
        "latent_image": [
          "5",
          2
        ],
        "seed": 1,
        "steps": 25,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      },
      "_meta": {
        "control_after_generate": {
          "seed": "randomize"
        }
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "7",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "8",
          0
        ],
        "filename_prefix": "openillusion/qwen21-outfit-swap"
      }
    },
    "12": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{image:2}}"
      },
      "_meta": {
        "title": "Image 2"
      }
    }
  },
  "cover": "media/cover-outfit-swap.webp"
}
