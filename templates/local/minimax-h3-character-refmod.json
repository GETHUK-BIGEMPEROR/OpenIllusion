    },
    "141": {
      "class_type": "ComfySwitchNode",
      "inputs": {
        "switch": [
          "146",
          0
        ],
        "on_false": [
          "147",
          0
        ],
        "on_true": [
          "203",
          0
        ]
      },
      "_meta": {
        "title": "If/Else Switch (model)"
