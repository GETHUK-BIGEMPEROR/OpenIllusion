{
  "model": "wan/wan3.0-video",
  "name": "Wan 3.0",
  "makes": "video",
  "body": {
    "input": {
      "prompt": ""
    },
    "parameters": {
      "resolution": "720P",
      "duration": 5
    }
  },
  "prompt": [
    "input",
    "prompt"
  ],
  "inputs": [
    {
      "role": "First frame",
      "type": "image",
      "at": [
        "input",
        "media",
        "+"
      ],
      "value": {
        "type": "first_frame",
        "url": "{{$|uri}}"
      },
      "set": [
        "frames"
      ],
      "fit": {
        "short": [
          240,
          null
        ],
        "long": [
          null,
          8000
        ],
        "aspect": [
          0.125,
          8
        ],
        "mb": 20
      }
    },
    {
      "role": "Last frame",
      "type": "image",
      "at": [
        "input",
        "media",
        "+"
      ],
      "value": {
        "type": "last_frame",
        "url": "{{$|uri}}"
      },
      "set": [
        "frames"
      ],
      "needs": "First frame",
      "fit": {
        "short": [
          240,
          null
        ],
        "long": [
          null,
          8000
        ],
        "aspect": [
          0.125,
          8
        ],
        "mb": 20
      }
    },
    {
      "role": "Reference image",
      "type": "image",
      "at": [
        "input",
        "media",
        "+"
      ],
      "value": {
        "type": "reference_image",
        "url": "{{$|uri}}"
      },
      "set": [
        "references"
      ],
      "max": 10,
      "fit": {
        "short": [
          240,
          null
        ],
        "long": [
          null,
          8000
        ],
        "aspect": [
          0.125,
          8
        ],
        "mb": 20
      }
    },
    {
      "role": "Reference video",
      "type": "video",
      "at": [
        "input",
        "media",
        "+"
      ],
      "value": {
        "type": "reference_video",
        "url": "{{$|url}}"
      },
      "set": [
        "references"
      ],
      "max": 5,
      "fit": {
        "total": 15
      }
    },
    {
      "role": "Reference audio",
      "type": "audio",
      "at": [
        "input",
        "media",
        "+"
      ],
      "value": {
        "type": "reference_audio",
        "url": "{{$|url}}"
      },
      "set": [
        "references"
      ],
      "max": 5,
      "fit": {
        "total": 15
      }
    }
  ],
  "settings": [
    {
      "key": "aspect",
      "label": "Aspect",
      "type": "aspect",
      "at": [
        "parameters",
        "ratio"
      ],
      "options": [
        "16:9",
        "9:16",
        "1:1",
        "4:3",
        "3:4",
        "adaptive"
      ],
      "labels": {
        "adaptive": "Auto"
      },
      "default": "16:9",
      "off_with": [
        "First frame",
        "Last frame"
      ]
    },
    {
      "key": "resolution",
      "label": "Resolution",
      "type": "segmented",
      "at": [
        "parameters",
        "resolution"
      ],
      "options": [
        "480P",
        "720P",
        "1080P"
      ],
      "labels": {
        "480P": "480p",
        "720P": "720p",
        "1080P": "1080p"
      },
      "default": "720P"
    },
    {
      "key": "duration",
      "label": "Duration",
      "type": "int",
      "at": [
        "parameters",
        "duration"
      ],
      "min": 2,
      "max": 30,
      "default": 5,
      "unit": "s"
    },
    {
      "key": "sound",
      "label": "Sound",
      "type": "bool",
      "at": [
        "parameters",
        "audio"
      ],
      "default": true,
      "help": "Make sound with the clip"
    }
  ],
  "result": [
    [
      "output",
      "video_url"
    ]
  ]
}
