{
  "format": "openillusion.template",
  "version": 2,
  "mode": "motion",
  "label": "Swap a character",
  "blurb": "Puts the character from Image 1 into Video 1 in place of the one in it, on Seedance 2.5. Runs on Comfy Router with your key.",
  "inputs": [
    {
      "key": "image:1",
      "type": "image",
      "required": true,
      "bind": [
        [
          "content",
          1
        ]
      ],
      "default": "media/character-swap-sample-image-1.jpg"
    },
    {
      "key": "video:1",
      "type": "video",
      "required": true,
      "bind": [
        [
          "content",
          2
        ]
      ],
      "default": "media/character-swap-sample-video-1.mp4"
    },
    {
      "key": "prompt",
      "type": "text",
      "required": true,
      "default": "Edit Video 1 to replace the character on the Video 1 with the character from Image 1",
      "bind": [
        [
          "content",
          0,
          "text"
        ]
      ]
    },
    {
      "key": "resolution",
      "type": "segmented",
      "label": "Resolution",
      "default": "480p",
      "bind": [
        [
          "resolution"
        ]
      ],
      "options": [
        "480p",
        "720p",
        "1080p",
        "4k"
      ],
      "labels": {
        "4k": "4K"
      }
    },
    {
      "key": "sound",
      "type": "segmented",
      "label": "Sound",
      "default": "clip",
      "bind": [
        [
          "generate_audio"
        ]
      ],
      "options": [
        "new",
        "clip",
        "none"
      ],
      "labels": {
        "new": "Make new",
        "clip": "Keep the clip's",
        "none": "None"
      },
      "send": {
        "new": true,
        "clip": false,
        "none": false
      },
      "help": "Make new: Seedance makes the sound. Keep the clip's: the video you edit keeps its own sound. None: silent.",
      "keep_sound": {
        "option": "clip",
        "slot": "video:1"
      }
    }
  ],
  "built": true,
  "kind": "cloud",
  "model": "byteplus/dreamina-seedance-2-5-260628",
  "provider": "byteplus",
  "body": {
    "content": [
      {
        "type": "text",
        "text": "Edit Video 1 to replace the character on the Video 1 with the character from Image 1"
      },
      {
        "type": "image_url",
        "role": "reference_image",
        "image_url": {
          "url": "{{image:1|uri}}"
        }
      },
      {
        "type": "video_url",
        "role": "reference_video",
        "video_url": {
          "url": "{{video:1|url}}"
        }
      }
    ],
    "resolution": "480p",
    "generate_audio": false,
    "duration": -1
  },
  "result": [
    [
      "content",
      "video_url"
    ]
  ],
  "source": "Comfy Router · Seedance 2.5",
  "locked": [],
  "added": 1793275910.1039164,
  "id": "cloud/character-swap",
  "cover": "media/cover-character-swap.webp",
  "cover_video": "media/cover-character-swap.mp4"
}
