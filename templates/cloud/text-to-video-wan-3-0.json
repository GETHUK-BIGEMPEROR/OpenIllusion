      "type": "text",
      "required": true,
      "default": "Medium shot, two friends side by side at a neon-lit karaoke bar, each holding a microphone, singing a chorus with big expressions, the one on the left points at the one on the right on the high note, both laugh. Pink and blue light, handheld camera, no cuts.",
      "bind": [
        [
          "input",
          "prompt"
        ]
      ]
    },
    {
      "key": "aspect",
      "type": "aspect",
      "label": "Aspect",
      "default": "16:9",
      "bind": [
        [
          "parameters",
          "ratio"
        ]
      ],
      "options": [
        "16:9",
        "9:16",
        "1:1",
        "4:3",
        "3:4",
        "adaptive"
      ],
      "labels": {
        "adaptive": "Auto"
      }
    },
    {
      "key": "resolution",
      "type": "segmented",
      "label": "Resolution",
      "default": "480P",
      "bind": [
        [
          "parameters",
          "resolution"
        ]
      ],
      "options": [
        "480P",
        "720P",
        "1080P"
      ],
      "labels": {
        "480P": "480p",
        "720P": "720p",
        "1080P": "1080p"
      }
    },
    {
      "key": "duration",
      "type": "int",
      "label": "Duration",
      "default": 5,
      "bind": [
        [
          "parameters",
          "duration"
        ]
      ],
      "min": 2,
      "max": 30,
      "unit": "s"
    },
    {
      "key": "sound",
      "type": "bool",
      "label": "Sound",
      "default": true,
      "bind": [
        [
          "parameters",
          "audio"
        ]
      ],
      "help": "Make sound with the clip"
    }
