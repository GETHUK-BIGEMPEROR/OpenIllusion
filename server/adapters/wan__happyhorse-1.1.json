{
  "model": "wan/happyhorse-1.1",
  "name": "HappyHorse 1.1",
  "makes": "video",
  "body": {
    "input": {
      "prompt": ""
    },
    "parameters": {
      "resolution": "720P",
      "duration": 5
    }
  },
  "prompt": [
    "input",
    "prompt"
  ],
  "inputs": [
    {
      "role": "First frame",
      "type": "image",
      "at": [
        "input",
        "media",
        "+"
      ],
      "value": {
        "type": "first_frame",
        "url": "{{$|uri}}"
      },
      "fit": {
        "short": [
          300,
          null
        ],
        "aspect": [
          0.4,
          2.5
        ],
        "mb": 20
      }
    },
    {
      "role": "Reference image",
      "type": "image",
      "at": [
        "input",
        "media",
        "+"
      ],
      "value": {
        "type": "reference_image",
        "url": "{{$|uri}}"
      },
      "max": 9,
      "max_with": {
        "roles": [
          "Video to edit"
        ],
        "max": 5
      },
      "fit": {
        "short": [
          400,
          null
        ],
        "mb": 20
      }
    },
    {
      "role": "Video to edit",
      "type": "video",
      "at": [
        "input",
        "media",
        "+"
      ],
      "value": {
        "type": "video",
        "url": "{{$|url}}"
      },
      "drop": [
        [
          "parameters",
          "duration"
        ]
      ],
      "fit": {
        "short": [
          360,
          null
        ],
        "long": [
          null,
          4096
        ],
        "aspect": [
          0.4,
          2.5
        ],
        "seconds": [
          3,
          60
        ],
        "mb": 100
      }
    }
  ],
  "settings": [
    {
      "key": "resolution",
      "label": "Resolution",
      "type": "segmented",
      "at": [
        "parameters",
        "resolution"
      ],
      "options": [
        "720P",
        "1080P"
      ],
      "labels": {
        "720P": "720p",
        "1080P": "1080p"
      },
      "default": "720P"
    },
    {
      "key": "duration",
      "label": "Duration",
      "type": "segmented",
      "at": [
        "parameters",
        "duration"
      ],
      "options": [
        5,
        10
      ],
      "default": 5,
      "unit": "s",
      "off_with": [
        "Video to edit"
      ]
    }
  ],
  "models": [
    {
      "model": "wan/happyhorse-1.1-t2v",
      "takes": []
    },
    {
      "model": "wan/happyhorse-1.1-i2v",
      "takes": [
        "First frame"
      ]
    },
    {
      "model": "wan/happyhorse-1.1-r2v",
      "takes": [
        "Reference image"
      ]
    },
    {
      "model": "wan/happyhorse-1.0-video-edit",
      "takes": [
        "Video to edit",
        "Reference image"
      ]
    }
  ],
  "result": [
    [
      "output",
      "video_url"
    ]
  ]
}
