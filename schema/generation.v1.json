  "required": [
    "id",
    "mode",
    "engine"
  ],
  "title": "OpenIllusion generation manifest, version 1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openillusion:generation:v1"
}
