{
  "format": "openillusion.template",
  "version": 2,
  "id": "local/qwen21-cutout",
  "mode": "edit",
  "label": "Remove background · Qwen Image 2.1",
  "provider": "qwen",
  "blurb": "Cuts the subject out of Image 1 and saves it as a PNG with a transparent background.",
  "source": "ComfyUI template image_qwen_image_2_1_background_removal",
  "tags": [
    "cutout",
    "product",
    "portrait"
  ],
  "tips": [
    "One clear subject cuts cleanest; busy group shots can keep extra people.",
    "The result is a PNG with real transparency, ready to drop on any background."
  ],
  "inputs": [
    {
      "key": "image:1",
      "type": "image",
      "label": "Photo",
      "hint": "Any photo with a clear subject: a person, a product, a pet.",
      "required": true,
      "size": "1 MP",
      "default": "media/woman-portrait.jpg",
      "bind": [
        [
          "470",
          "image"
        ]
      ]
    },
    {
      "key": "prompt",
      "type": "text",
      "label": "Prompt",
      "required": true,
      "default": "Remove the background, and output a PNG image",
      "examples": [
        {
          "label": "Whole subject",
          "text": "Remove the background, and output a PNG image"
        },
        {
          "label": "Product only",
          "text": "Remove the background and anything that is not the product, and output a PNG image"
        }
      ],
      "bind": [
        [
          "459:474",
          "prompt"
        ]
      ]
    },
    {
      "key": "steps",
      "type": "int",
      "label": "Steps",
      "advanced": true,
      "min": 8,
      "max": 40,
      "default": 25,
      "bind": [
        [
          "459:458",
          "steps",
          "int"
        ]
      ]
    },
    {
      "key": "seed",
      "type": "seed",
      "label": "Seed",
      "advanced": true,
      "default": -1,
      "bind": [
        [
          "459:458",
          "seed",
          "int"
        ]
      ]
    },
    {
      "key": "cache",
      "type": "segmented",
      "label": "Step cache",
      "advanced": true,
      "help": "Where Qwen 2.1 keeps its step cache. cpu (RAM) is safe on 16 GB cards and costs little speed. auto and gpu take spare VRAM and can run out of memory.",
      "options": [
        "cpu",
        "auto",
        "gpu",
        "off"
      ],
      "default": "cpu",
      "bind": [
        [
          "459:469",
          "device"
        ]
      ]
    }
  ],
  "size": {
    "multiple": 32,
    "follows": "image:1"
  },
  "outputs": [
    "461"
  ],
  "hints": {
    "models": {
      "qwen_image_2.1_int8_convrot.safetensors": {
        "folder": "diffusion_models",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/diffusion_models/qwen_image_2.1_int8_convrot.safetensors"
      },
      "qwen3vl_8b_int8_convrot.safetensors": {
        "folder": "text_encoders",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/text_encoders/qwen3vl_8b_int8_convrot.safetensors"
      },
      "qwen_image_2.1_vae_bf16.safetensors": {
        "folder": "vae",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/vae/qwen_image_2.1_vae_bf16.safetensors"
      }
    },
    "nodes": {}
  },
  "workflow": {
    "459:451": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "459:453": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
        "type": "qwen_image",
        "device": "default"
      }
    },
    "459:454": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
      }
    },
    "459:456": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "459:457": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "459:458",
          0
        ],
        "vae": [
          "459:454",
          0
        ]
      }
    },
    "459:458": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 1,
        "steps": 25,
        "cfg": 1,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1,
        "model": [
          "459:469",
          0
        ],
        "positive": [
          "459:474",
          0
        ],
        "negative": [
          "459:474",
          1
        ],
        "latent_image": [
          "459:468",
          0
        ]
      }
    },
    "459:468": {
      "class_type": "ComfySwitchNode",
      "inputs": {
        "switch": false,
        "on_false": [
          "459:474",
          2
        ],
        "on_true": [
          "459:456",
          0
        ]
      }
    },
    "459:469": {
      "class_type": "QwenImage21Cache",
      "inputs": {
        "device": "cpu",
        "dtype": "default",
        "model": [
          "459:451",
          0
        ]
      }
    },
    "459:474": {
      "class_type": "TextEncodeQwenImage21",
      "inputs": {
        "prompt": "Remove the background, and output a PNG image",
        "negative_prompt": "",
        "resolution": 0,
        "clip": [
          "459:453",
          0
        ],
        "images.image_1": [
          "470",
          0
        ],
        "vae": [
          "459:454",
          0
        ]
      }
    },
    "461": {
      "class_type": "SaveImageAdvanced",
      "inputs": {
        "filename_prefix": "openillusion/qwen21-cutout",
        "format": "png",
        "format.bit_depth": "8-bit",
        "format.input_color_space": "sRGB",
        "images": [
          "459:457",
          0
        ]
      }
    },
    "470": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{image:1}}"
      }
    }
  },
  "cover": "media/cover-cutout.webp"
}
