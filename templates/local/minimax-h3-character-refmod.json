{
  "format": "openillusion.template",
  "version": 2,
  "mode": "motion",
  "label": "Character swap with RefMod · MiniMax H3",
  "blurb": "Puts a character into Video 1 in place of one person. Pick their RefMod: it carries all their photos, so the look holds from every angle. Image 1 is optional: another photo to go with it, like an outfit.",
  "tags": [
    "swap",
    "character",
    "refmod",
    "lora"
  ],
  "size": {
    "multiple": 32
  },
  "inputs": [
    {
      "key": "video:1",
      "type": "video",
      "required": true,
      "bind": [
        [
          "139",
          "file"
        ]
      ],
      "default": "media/walk-street.mp4",
      "size": "0.4 MP"
    },
    {
      "key": "refmod:1",
      "type": "refmod",
      "required": true,
      "bind": [
        [
          "201",
          "mod_1"
        ]
      ]
    },
    {
      "key": "image:1",
      "type": "image",
      "required": false,
      "bind": [
        [
          "137",
          "image"
        ]
      ]
    },
    {
      "key": "prompt",
      "type": "text",
      "required": true,
      "default": "Replace only the woman in the foreground in <Video 1> with the character from the reference. Keep the character's identity, face, hair, outfit, and style. Preserve the source video's camera, framing, background, lighting, objects, and all other people. Match the selected woman's position, scale, pose, and movement throughout the clip. Do not show the reference sheet or its background.",
      "bind": [
        [
          "138",
          "value"
        ]
      ],
      "examples": [
        {
          "label": "Swap in the character",
          "text": "Replace only the woman in the foreground in <Video 1> with the character from the reference. Keep the character's identity, face, hair, outfit, and style. Preserve the source video's camera, framing, background, lighting, objects, and all other people. Match the selected woman's position, scale, pose, and movement throughout the clip. Do not show the reference sheet or its background."
        },
        {
          "label": "Outfit from Image 1",
          "text": "Replace only the woman in the foreground in <Video 1> with the character from the reference, wearing the outfit from <Picture 1>. Keep the character's identity, face, hair, and style. Preserve the source video's camera, framing, background, lighting, objects, and all other people. Match the selected woman's position, scale, pose, and movement throughout the clip. Do not show the reference sheet or its background."
        }
      ]
    },
    {
      "key": "sound",
      "type": "segmented",
      "label": "Sound",
      "options": [
        "new",
        "clip"
      ],
      "labels": {
        "new": "Make new",
        "clip": "Keep the clip's"
      },
      "default": "new",
      "keep_sound": {
        "option": "clip",
        "slot": "video:1"
      },
      "help": "Make new: MiniMax H3 makes the sound. Keep the clip's: the result keeps Video 1's own sound."
    }
  ],
  "built": true,
  "kind": "local",
  "provider": "minimax",
  "outputs": [
    "92"
  ],
  "workflow": {
    "92": {
      "class_type": "SaveVideo",
      "inputs": {
        "filename_prefix": "video/H3_Character_Swap_v1",
        "format": "auto",
        "format.codec": "auto",
        "codec": "auto",
        "video": [
          "130",
          0
        ]
      }
    },
    "119": {
      "class_type": "VAELoader",
