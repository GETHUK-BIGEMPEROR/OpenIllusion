  "additionalProperties": true,
  "properties": {
    "format": {
      "const": "openillusion.generation",
      "default": "openillusion.generation",
      "title": "Format",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "default": "Untitled generation",
      "title": "Title",
      "type": "string"
    },
    "mode": {
      "enum": [
        "motion",
        "edit"
      ],
      "title": "Mode",
      "type": "string"
    },
    "created": {
      "title": "Created",
      "type": "number"
    },
    "engine": {
      "$ref": "#/$defs/Engine"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputItem"
      },
      "title": "Inputs",
      "type": "array"
    },
    "prompt": {
      "default": "",
      "title": "Prompt",
      "type": "string"
    },
    "boxes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Boxes",
      "type": "array"
    },
    "params": {
      "additionalProperties": true,
      "title": "Params",
      "type": "object"
    },
    "request_template": {
      "additionalProperties": true,
      "title": "Request Template",
      "type": "object"
    },
