      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "worked",
            "partly",
            "didnt"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "starred": {
      "default": false,
      "title": "Starred",
      "type": "boolean"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "attest": {
      "$ref": "#/$defs/Attest"
    },
    "variant": {
      "anyOf": [
        {
          "enum": [
            "full",
            "light",
            "recipe"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Variant"
    }
