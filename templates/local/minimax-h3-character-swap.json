{
  "format": "openillusion.template",
  "version": 2,
  "mode": "motion",
  "label": "Character swap · MiniMax H3",
  "blurb": "Puts the character from Image 1 into Video 1 in place of one person. Their pose, timing, camera and scene stay; face, hair and outfit come from the photo.",
  "size": {
    "multiple": 32
  },
  "inputs": [
    {
      "key": "video:1",
      "type": "video",
      "required": true,
      "bind": [
        [
          "139",
          "file"
        ]
      ],
      "default": "media/walk-street.mp4",
      "size": "0.4 MP"
    },
    {
      "key": "image:1",
      "type": "image",
      "required": true,
      "bind": [
        [
          "137",
          "image"
        ]
      ],
      "default": "media/man-mustard.jpg"
    },
    {
      "key": "prompt",
      "type": "text",
      "required": true,
      "default": "Replace only the woman in the foreground in <Video 1> with the character in <Picture 1>. Keep the replacement character's identity, outfit, and art style from <Picture 1>. Preserve the source video's camera, framing, background, lighting, objects, and all other people. Match the selected woman's position, scale, pose, and movement throughout the clip. Do not show the reference sheet or its background.",
      "bind": [
        [
          "138",
          "value"
        ]
      ]
    },
    {
      "key": "sound",
      "type": "segmented",
      "label": "Sound",
      "options": [
        "new",
        "clip"
      ],
      "labels": {
        "new": "Make new",
        "clip": "Keep the clip's"
      },
      "default": "new",
      "keep_sound": {
        "option": "clip",
        "slot": "video:1"
      },
      "help": "Make new: MiniMax H3 makes the sound. Keep the clip's: the result keeps Video 1's own sound."
    }
  ],
  "built": true,
  "kind": "local",
  "provider": "minimax",
  "outputs": [
    "92"
  ],
  "workflow": {
    "92": {
      "class_type": "SaveVideo",
