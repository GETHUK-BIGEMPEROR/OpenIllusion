{
  "format": "openillusion.template",
  "version": 2,
  "id": "local/qwen21-recolor",
  "mode": "edit",
  "label": "Recolor · Qwen Image 2.1",
  "provider": "qwen",
  "blurb": "Changes the color of one thing in Image 1, keeping its material, shading and detail.",
  "source": "ComfyUI template image_qwen_image_2_1_image_edit (prompt enhancer left out)",
  "inputs": [
    {
      "key": "image:1",
      "type": "image",
      "required": true,
      "default": "media/sneaker-canvas.jpg",
      "bind": [
        [
          "11",
          "image"
        ]
      ]
    },
    {
      "key": "prompt",
      "type": "text",
      "required": true,
      "default": "In <image1>, change the color of the shoe to matte black with a white sole. Keep the material, texture, shading, reflections and every detail of it; only the color changes. Keep everything else in the image exactly as it is.",
      "bind": [
        [
          "5",
          "prompt"
        ]
      ]
    }
  ],
  "size": {
    "multiple": 32
  },
  "outputs": [
    "9"
  ],
  "hints": {
    "models": {
      "qwen_image_2.1_int8_convrot.safetensors": {
        "folder": "diffusion_models",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/diffusion_models/qwen_image_2.1_int8_convrot.safetensors"
      },
      "qwen3vl_8b_int8_convrot.safetensors": {
        "folder": "text_encoders",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/text_encoders/qwen3vl_8b_int8_convrot.safetensors"
      },
      "qwen_image_2.1_vae_bf16.safetensors": {
        "folder": "vae",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/vae/qwen_image_2.1_vae_bf16.safetensors"
      }
    },
    "nodes": {}
  },
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "QwenImage21Cache",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "device": "cpu",
        "dtype": "default"
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
        "type": "qwen_image",
        "device": "default"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
      }
    },
    "11": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{image:1}}"
      },
      "_meta": {
        "title": "Image 1"
      }
    },
    "5": {
      "class_type": "TextEncodeQwenImage21",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "prompt": "In <image1>, change the color of the shoe to matte black with a white sole. Keep the material, texture, shading, reflections and every detail of it; only the color changes. Keep everything else in the image exactly as it is.",
        "negative_prompt": "",
        "resolution": 0,
        "images.image_1": [
          "11",
          0
        ]
      },
      "_meta": {
        "title": "Edit"
      }
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "negative": [
          "5",
          1
        ],
        "latent_image": [
          "5",
          2
        ],
        "seed": 1,
        "steps": 25,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      },
      "_meta": {
        "control_after_generate": {
          "seed": "randomize"
        }
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "7",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "8",
          0
        ],
        "filename_prefix": "openillusion/qwen21-recolor"
      }
    }
  },
  "cover": "media/cover-recolor.webp"
}
