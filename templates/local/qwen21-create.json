{
  "format": "openillusion.template",
  "version": 2,
  "id": "local/qwen21-create",
  "mode": "edit",
  "label": "Create a photo",
  "model_name": "Qwen Image 2.1",
  "provider": "qwen",
  "blurb": "Makes a picture from words alone: photos, product shots, posters with lettering, illustrations.",
  "source": "ComfyUI template image_qwen_image_2_1_t2i (prompt enhancer left out)",
  "inputs": [
    {
      "key": "prompt",
      "type": "text",
      "required": true,
      "default": "High quality photograph of a young Korean woman cycling along a Copenhagen canal street at golden hour, hair moving in the wind, a canvas tote in the front basket, colorful townhouses softly blurred behind her. Candid, warm natural light, shot on 35mm film.",
      "bind": [
        [
          "459:452",
          "prompt"
        ]
      ]
    },
    {
      "key": "size",
      "type": "size",
      "label": "Output size",
      "aspects": [
        "1:1",
        "4:5",
        "3:4",
        "2:3",
        "9:16",
        "16:9",
        "3:2",
        "4:3"
      ],
      "aspect": "4:5",
      "default": "2 MP",
      "bind": [
        [
          "459:456",
          "width",
          "width"
        ],
        [
          "459:456",
          "height",
          "height"
        ]
      ]
    }
  ],
  "size": {
    "multiple": 32
  },
  "outputs": [
    "461"
  ],
  "hints": {
    "models": {
      "qwen_image_2.1_int8_convrot.safetensors": {
        "folder": "diffusion_models",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/diffusion_models/qwen_image_2.1_int8_convrot.safetensors"
      },
      "qwen3vl_8b_int8_convrot.safetensors": {
        "folder": "text_encoders",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/text_encoders/qwen3vl_8b_int8_convrot.safetensors"
      },
      "qwen_image_2.1_vae_bf16.safetensors": {
        "folder": "vae",
        "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/vae/qwen_image_2.1_vae_bf16.safetensors"
      }
    },
    "nodes": {}
  },
  "workflow": {
    "459:451": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "459:452": {
      "class_type": "TextEncodeQwenImage21",
      "inputs": {
        "prompt": "High quality photograph of a young Korean woman cycling along a Copenhagen canal street at golden hour, hair moving in the wind, a canvas tote in the front basket, colorful townhouses softly blurred behind her. Candid, warm natural light, shot on 35mm film.",
        "negative_prompt": "",
        "resolution": 1024,
        "clip": [
          "459:453",
          0
        ]
      }
    },
    "459:453": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
        "type": "qwen_image",
        "device": "default"
      }
    },
    "459:454": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
      }
    },
    "459:456": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1088,
        "height": 1376,
        "batch_size": 1
      }
    },
    "459:457": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "459:458",
          0
        ],
        "vae": [
          "459:454",
          0
        ]
      }
    },
    "459:458": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 1,
        "steps": 25,
        "cfg": 1,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1,
        "model": [
          "459:480",
          0
        ],
        "positive": [
          "459:452",
          0
        ],
        "negative": [
          "459:452",
          1
        ],
        "latent_image": [
          "459:456",
          0
        ]
      },
      "_meta": {
        "control_after_generate": {
          "seed": "fixed"
        }
      }
    },
    "459:480": {
      "class_type": "QwenImage21Cache",
      "inputs": {
        "device": "cpu",
        "dtype": "default",
        "model": [
          "459:451",
          0
        ]
      }
    },
    "461": {
      "class_type": "SaveImageAdvanced",
      "inputs": {
        "filename_prefix": "openillusion/qwen21-create",
        "format": "png",
        "format.bit_depth": "8-bit",
        "format.input_color_space": "sRGB",
        "images": [
          "459:457",
          0
        ]
      }
    }
  },
  "cover": "media/cover-create-photo.webp"
}
