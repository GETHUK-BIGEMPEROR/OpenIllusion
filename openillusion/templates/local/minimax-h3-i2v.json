{
  "format": "openillusion.template",
  "version": 1,
  "id": "local/minimax-h3-i2v",
  "mode": "motion",
  "label": "MiniMax H3 · local",
  "provider": "minimax",
  "blurb": "Image to video on your own GPU, with audio. Animates Image 1 from the prompt; no driving video. From ComfyUI's MiniMax H3 image-to-video template.",
  "source": "ComfyUI template video_minimax_h3_i2v (flattened, turbo LoRA always on)",
  "max_images": 1,
  "min_images": 1,
  "needs_video": false,
  "params": [
    {"key": "duration", "label": "Duration", "type": "int", "min": 1, "max": 10, "default": 3, "unit": "s"},
    {"key": "megapixels", "label": "Size", "type": "segmented", "options": ["0.2", "0.4", "0.6", "0.9"], "default": "0.4", "help": "Megapixels of the output, keeping Image 1's aspect. 0.9 is about 1280 × 736."},
    {"key": "steps", "label": "Steps", "type": "int", "min": 2, "max": 12, "default": 4, "help": "The turbo LoRA is trained for 4."},
    {"key": "seed", "label": "Seed", "type": "seed", "default": -1}
  ],
  "bindings": {
    "prompt": [["20", "prompt"]],
    "image:1": [["1", "image"]],
    "params.duration": [["21", "value", "float"]],
    "params.megapixels": [["2", "megapixels", "float"]],
    "params.steps": [["32", "steps", "int"]],
    "params.seed": [["30", "noise_seed", "int"]]
  },
  "outputs": ["43"],
  "hints": {
    "models": {
      "minimax_h3_fl2va_pruned_int8_convrot.safetensors": {"folder": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors"},
      "qwen3vl_32b_minimax_h3_int8_convrot.safetensors": {"folder": "text_encoders", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/tree/main/text_encoders"},
      "minimax_h3_video_vae_int8_convrot.safetensors": {"folder": "vae", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_video_vae_int8_convrot.safetensors"},
      "minimax_h3_audio_vae_fp32.safetensors": {"folder": "vae", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_audio_vae_fp32.safetensors"},
      "minimax_h3_fl2v_turbo_4step_v1.0_768p_comfyui_bf16.safetensors": {"folder": "loras", "url": "https://huggingface.co/lightx2v/Minimax-h3-Turbo/tree/main"}
    },
    "nodes": {}
  },
  "workflow": {
    "1": {"class_type": "LoadImage", "inputs": {"image": "{{image:1}}"}, "_meta": {"title": "Image 1"}},
    "2": {"class_type": "ImageScaleToTotalPixels", "inputs": {"image": ["1", 0], "upscale_method": "lanczos", "megapixels": 0.4, "resolution_steps": 32}},
    "3": {"class_type": "GetImageSize", "inputs": {"image": ["2", 0]}},
    "10": {"class_type": "UNETLoader", "inputs": {"unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}},
    "11": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["10", 0], "lora_name": "minimax_h3_fl2v_turbo_4step_v1.0_768p_comfyui_bf16.safetensors", "strength_model": 1.0}},
    "12": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors", "type": "minimax", "device": "default"}},
    "13": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"}},
    "14": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
    "20": {"class_type": "MiniMaxH3ImageToVideo", "inputs": {"clip": ["12", 0], "vae": ["13", 0], "prompt": "", "width": ["3", 0], "height": ["3", 1], "length": ["22", 1], "first_frame": ["2", 0]}, "_meta": {"title": "Prompt"}},
    "21": {"class_type": "PrimitiveFloat", "inputs": {"value": 3.0}, "_meta": {"title": "Duration (s)"}},
    "22": {"class_type": "ComfyMathExpression", "inputs": {"expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17", "values.a": ["21", 0]}, "_meta": {"title": "Frames on the 17k+5 grid"}},
    "30": {"class_type": "RandomNoise", "inputs": {"noise_seed": 1}},
    "31": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
    "32": {"class_type": "BasicScheduler", "inputs": {"model": ["11", 0], "scheduler": "simple", "steps": 4, "denoise": 1.0}},
    "33": {"class_type": "BasicGuider", "inputs": {"model": ["11", 0], "conditioning": ["20", 0]}},
    "34": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["30", 0], "guider": ["33", 0], "sampler": ["31", 0], "sigmas": ["32", 0], "latent_image": ["20", 1]}},
    "40": {"class_type": "VAEDecode", "inputs": {"samples": ["34", 0], "vae": ["13", 0]}},
    "41": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["34", 0], "vae": ["14", 0]}},
    "42": {"class_type": "CreateVideo", "inputs": {"images": ["40", 0], "audio": ["41", 0], "fps": 24.0}},
    "43": {"class_type": "SaveVideo", "inputs": {"video": ["42", 0], "filename_prefix": "openillusion/h3", "format": "auto", "format.codec": "auto"}}
  }
}
